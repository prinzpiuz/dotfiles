[includeIf "gitdir:~/projects/work/Nuventure"]
    path = ~/.gitconfig-nuventure

[core]
    editor = nvim

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

# if merge conflicts,
# Resolve the Code, 
# Stage the Change: Run git add <filename>
# Continue the Rebase: Run git rebase --continue
# If you want to abort the rebase and return to the state before the rebase started, you can run:
# git rebase --abort
# after successfull rebase, since history is re-written we need to do git push --force-with-lease
#Note: If you had multiple commits that conflict, Git might pause again for the next one. Repeat these steps until the rebase is finished

[rebase]
    autoStash = true

# [rerere]
#     enabled = true

[diff]
    tool = nvimdiff
    guitool = kitty.gui
    algorithm = histogram

[difftool]
    prompt = false
    trustExitCode = true

[difftool "nvimdiff"]
    cmd = nvim -d $LOCAL $REMOTE

[difftool "kitty"]
    cmd = kitty +kitten diff $LOCAL $REMOTE

[difftool "kitty.gui"]
    cmd = kitty kitty +kitten diff $LOCAL $REMOTE

[merge]
    tool = nvimdiff
    conflictstyle = diff3

[mergetool]
    prompt = false
    keepBackup = false

[mergetool "nvimdiff"]
    cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c 'wincmd J'

[column]
    ui = auto

[branch]
    sort = -committerdate

[alias]
    # --- Daily workflow shortcuts ---
    s = status --short --branch
    co = checkout
    cb = checkout -b
    sw = switch
    sc = switch -c
    aa = add --all
    cm = commit -m
    ca = commit --amend --no-edit
    pf = push --force-with-lease
    pl = pull
    lg = log --oneline --graph --decorate -20
    la = log --oneline --graph --decorate --all -30
    d = diff
    ds = diff --staged
    undo = reset --soft HEAD~1
    unstage = restore --staged .
    wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
