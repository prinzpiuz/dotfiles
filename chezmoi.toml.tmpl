[diff]
    command = "nvim"
    args = ["-d", {{ printf "%q" "{{ .Destination }}" }}, {{ printf "%q" "{{ .Target }}" }}]
[merge]
    command = "nvim"
    args = ["-d", {{ printf "%q" "{{ .Destination }}" }}, {{ printf "%q" "{{ .Source }}" }}, {{ printf "%q" "{{ .Target }}" }}]
[edit]
    command = "nvim"
[git]
    autoCommit = true
    autoPush = true
[status]
    pathStyle = "relative"
